# GitLab
GITLAB__URL=https://gitlab.example.com
GITLAB__PERSONAL_ACCESS_TOKEN=your_gitlab_token
GITLAB__SHARED_SECRET=your_webhook_secret

# Model provider
OPENAI__KEY=your_model_api_key
OPENAI__API_BASE=

# Distributed runtime
PR_AGENT_EXECUTION_MODE=queue
PR_AGENT_REDIS_URL=redis://pr_agent:your_redis_password@pr-agent-redis:6379/0

# Optional Feishu integration
FEISHU__APP_ID=
FEISHU__APP_SECRET=

# Optional CI Repair Agent override
UT_AGENT_API_KEY=
UT_AGENT_API_BASE=

# Docker Compose paths
MR_AGENT_HOME=./runtime
MR_AGENT_ENV_FILE=.env
